# Minimal config the Worker needs to run (bindings + migrations).
# Add account_id, routes, and [vars] only when your deployment needs them.

name = "cf-img-gallery"
main = "src/index.ts"
compatibility_date = "2026-01-05"

# Optional: omit if `wrangler deploy` already uses your default account (wrangler whoami).
# account_id = "<your-account-id>"

# Disable workers.dev when serving through custom production routes.
workers_dev = false

# Optional: only required for a custom hostname (zone). Omit for workers.dev-only testing.
# routes = [
#   { pattern = "yourdomain.com/*", zone_id = "<your-zone-id>" },
# ]

[[r2_buckets]]
binding = "IMAGES_BUCKET"
bucket_name = "images-bucket"

[[durable_objects.bindings]]
name = "IMAGE_INDEX"
class_name = "ImageIndex"

[[migrations]]
tag = "001_init"
new_sqlite_classes = ["ImageIndex"]

# Required [vars]. Admin routes return 401 when either is unset.
#
# ACCESS_TEAM_DOMAIN is required unless ACCESS_BYPASS_DEV = "true".
# It is your Cloudflare Access team. Any of these work:
#   "your-team"
#   "your-team.cloudflareaccess.com"
#   "https://your-team.cloudflareaccess.com"
# ACCESS_TEAM_DOMAIN = "your-team"
#
# ACCESS_AUD is required unless ACCESS_BYPASS_DEV = "true".
# It is the Access application's AUD tag (Zero Trust > Access > Applications > your app > Overview).
# ACCESS_AUD = "your-access-application-aud-tag"

# Optional [vars]. Unset means the defaults in the README.
#
# ADMIN_PATH is the admin URL prefix (default in code: /_admin). Set it for a non-default path.
# ADMIN_PATH = "/your-secret-admin-path"
#
# ACCESS_BYPASS_DEV skips Access. Add it ONLY for local `wrangler dev`.
# ACCESS_BYPASS_DEV = "true"
#
# R2_PUBLIC_HOST makes image resizing use this host as origin instead of the Worker /media route.
# R2_PUBLIC_HOST = "pub.example.com"
